  "input_semantics": {
    "pallet_types": ["FULL_PLT", "TAILGATE", "WOOD_CASE", "整板"],
    "box_types": ["FULL_CTN", "LOOSE_CTN"],
    "order_pallets": "sum(quantity for pallet_types) + ceil(sum(quantity for box_types) / 8)",
    "region_map": {
      "Dongguan": "Dongguan",
      "Shenzhen": "Shenzhen",
      "东莞": "Dongguan",
      "深圳": "Shenzhen"
    },
    "unmapped_city_region": "identity",
    "pickup_cap_by_region": {
      "Dongguan": 2,
      "Shenzhen": 3,
      "default": 3
    },
    "maximum_vehicle_capacity": "max(vehicle_types[*].capacity) from the case JSON",
    "locked_group_rule": "locked_vehicle_id is a group exactly when it is not null; the empty string is a valid locked group id"
  },
  "static_consolidation_headroom": {
    "symbol": "H",
    "hard_compatibility_cell": ["vehicle_subcategory", "vehicle_category", "region"],
    "pallet_lower_bound": "ceil(sum(order_pallets) / maximum_vehicle_capacity)",
    "pickup_lower_bound": "ceil(count(distinct pickup_name) / pickup_cap(region))",
    "amount_lower_bound": "max({1} union {ceil(cell_amount[key] / amount_limits[key]) for key in cell_amount intersect amount_limits})",
    "cell_vehicle_lower_bound": "LB_sg = max(1, pallet_lower_bound, pickup_lower_bound, amount_lower_bound)",
    "cell_atomic_unit_count": "A_sg = count(unlocked orders) + count(distinct non-null locked_vehicle_id)",
    "case_formula": "H(case) = sum over hard compatibility cells of max(0, A_sg - LB_sg)",
    "interpretation": "Static opportunity to consolidate independently movable input atoms above a conservative minimum-vehicle bound; not an objective estimate and not candidate effect."
  },
  "structure_diversity": {
    "coarse_vehicle_cell": ["vehicle_category", "region"],
    "coarse_vehicle_lower_bound": "LB_g uses the same max(1, pallet, pickup, amount) formula without vehicle_subcategory",
    "features": [
      {
        "name": "capacity_pressure",
        "symbol": "CP",
        "formula": "total_order_pallets / (maximum_vehicle_capacity * sum(LB_g))"
      },
      {
        "name": "locked_share",
        "symbol": "LS",
        "formula": "count(orders with non-null locked_vehicle_id) / order_count"
      },
      {
        "name": "hazard_share",
        "symbol": "HS",
        "formula": "count(orders with hazard_flag=true) / order_count"
      },
      {
        "name": "subcategory_count",
        "symbol": "Q",
        "formula": "count(distinct vehicle_subcategory)"
      }
    ],
    "pair_score": "Within one size cell, sum over CP,LS,HS,Q of abs(feature(a)-feature(b))/(cell_max-cell_min); a zero-range feature contributes zero.",
    "numeric_rule": "Compare integer ratios exactly; do not round a feature or pair score before selection."
  },
  "selection_algorithm": [
    "For each predeclared size cell, form LOW from all cases with minimum H and HIGH from all cases with maximum H.",
    "Among all distinct ordered pairs (low, high) in LOW x HIGH, choose the pair with maximum structure-diversity score.",
    "Break equal pair scores by lexicographically smallest (low manifest_index, high manifest_index).",
    "If minimum H equals maximum H, LOW and HIGH are the same full cell and the selected pair must still contain two distinct cases.",
    "Return the union of the four selected pairs in original manifest order. If any required input field is absent or invalid, return UNIDENTIFIABLE and choose no replacement case."
  ],
