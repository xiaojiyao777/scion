[Unit]
Description=Scion generic SpawnBackend formal run @CASE@
OnSuccess=@CLOSE_UNIT@
OnFailure=@CLOSE_UNIT@
CollectMode=inactive

[Service]
Type=exec
User=@FIXTURE_USER@
Group=@FIXTURE_GROUP@
UMask=0077
ExecStart=/usr/bin/python3.12 -I -B @RUN_PROGRAM@ --plan @RUN_PLAN@
ExecStopPost=/usr/bin/python3.12 -I -B @STOP_PROGRAM@ --plan @STOP_PLAN@
Restart=no
ExitType=main
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=infinity
OOMPolicy=stop
Delegate=pids
DelegateSubgroup=supervisor
NoNewPrivileges=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=no
ProtectProc=invisible
ProcSubset=all
ReadOnlyPaths=@SEALED_ROOT@ @INPUT_ROOT@
ReadWritePaths=@WORK_ROOT@ @FIFO_ROOT@
