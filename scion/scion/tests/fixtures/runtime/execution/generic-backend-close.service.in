[Unit]
Description=Scion generic SpawnBackend formal closer @CASE@
After=@RUN_UNIT@
CollectMode=inactive

[Service]
Type=oneshot
User=@FIXTURE_USER@
Group=@FIXTURE_GROUP@
UMask=0077
ExecStart=/usr/bin/python3.12 -I -B @CLOSE_PROGRAM@ --plan @CLOSE_PLAN@
Restart=no
TimeoutStartSec=infinity
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@SEALED_ROOT@ @INPUT_ROOT@
ReadWritePaths=@WORK_ROOT@ @FIFO_ROOT@
